# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Ursina / Panda3D runtime caches
*.bam
*.prc.user

# Patisson 1.0 assets ship in the Releases installer — too large for git
# (Меню.mp4 alone is ~224 MB, over GitHub's 100 MB/file limit). See ASSETS.md.
resources/
*.mp4
*.mp3
*.wav

# 2.0 generates its own models from code and they are small, so assets/ is
# tracked. Only the 1.0 resource dump stays out.

# Build / packaging
build/
dist/
*.exe
# PyInstaller writes its own .spec next to the build. This rule quietly ate
# android/buildozer.spec — the file that describes the whole APK — so the
# CI job failed on `cp` ten seconds in, three pushes running, and nothing
# said a word: `git add -A` skips ignored files in silence.
*.spec
!android/buildozer.spec

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/

# Claude Code workspace
.claude/
media/trailer.mp4
media/_*
