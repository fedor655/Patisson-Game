#version 430

// Progressive path tracer over the rasterised scene's own geometry.
//
// Triangles and a median-split BVH are uploaded once when photo mode opens;
// each dispatch adds a few samples per pixel to an accumulation image. Sky
// radiance comes from the same table the raster path uses, so the two agree.

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba32f) uniform image2D u_accum;

struct Tri {
    vec4 v0;        // xyz position, w unused
    vec4 v1;
    vec4 v2;
    vec4 albedo;    // rgb albedo, w = emissive strength
};

struct Node {
    vec4 bmin;      // xyz bounds min, w = left child (or -1 for a leaf)
    vec4 bmax;      // xyz bounds max, w = leaf triangle count
    vec4 extra;     // x = right child / first triangle index
};

layout(std430) buffer TriBuffer { Tri tris[]; };
layout(std430) buffer NodeBuffer { Node nodes[]; };

uniform sampler2D u_skyLut;
uniform vec3 u_camPos;
uniform vec3 u_camForward;
uniform vec3 u_camRight;
uniform vec3 u_camUp;
uniform vec2 u_tanHalfFov;
uniform vec3 u_sunDir;          // towards the sun, world space, Z-up
uniform vec3 u_sunColor;
uniform float u_sunAngularRadius;
uniform int u_samples;          // samples to add this dispatch
uniform int u_maxBounces;
uniform int u_frame;            // accumulation index, for the RNG
uniform int u_reset;
uniform vec2 u_resolution;

const float PI = 3.14159265359;
const float TAU = 6.28318530718;
const float INF = 1e30;

// --------------------------------------------------------------------- rng

uint rngState;

uint pcgHash(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float rand() {
    rngState = pcgHash(rngState);
    return float(rngState) * (1.0 / 4294967296.0);
}

vec3 cosineHemisphere(vec3 n) {
    float r1 = rand();
    float r2 = rand();
    float r = sqrt(r1);
    float phi = TAU * r2;
    vec3 t = normalize(abs(n.z) < 0.9 ? cross(vec3(0, 0, 1), n) : cross(vec3(1, 0, 0), n));
    vec3 b = cross(n, t);
    return normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + n * sqrt(max(1.0 - r1, 0.0)));
}

// ------------------------------------------------------------------- sky

vec2 dirToEquirect(vec3 d) {
    d = normalize(d);
    return vec2(atan(d.z, d.x) / TAU + 0.5, acos(clamp(d.y, -1.0, 1.0)) / PI);
}

vec3 skyRadiance(vec3 dir) {
    // The table is Y-up; the world is Z-up.
    return texture(u_skyLut, dirToEquirect(vec3(dir.x, dir.z, dir.y))).rgb;
}

// ------------------------------------------------------------ intersection

struct Hit {
    float t;
    vec3 n;
    vec3 albedo;
    float emissive;
};

bool intersectTri(vec3 ro, vec3 rd, Tri tri, inout float tBest, out vec3 normal) {
    vec3 e1 = tri.v1.xyz - tri.v0.xyz;
    vec3 e2 = tri.v2.xyz - tri.v0.xyz;
    vec3 p = cross(rd, e2);
    float det = dot(e1, p);
    if (abs(det) < 1e-9) return false;
    float inv = 1.0 / det;
    vec3 tv = ro - tri.v0.xyz;
    float u = dot(tv, p) * inv;
    if (u < 0.0 || u > 1.0) return false;
    vec3 q = cross(tv, e1);
    float v = dot(rd, q) * inv;
    if (v < 0.0 || u + v > 1.0) return false;
    float t = dot(e2, q) * inv;
    if (t <= 1e-4 || t >= tBest) return false;
    tBest = t;
    normal = normalize(cross(e1, e2));
    return true;
}

bool slabTest(vec3 ro, vec3 invDir, vec3 bmin, vec3 bmax, float tMax) {
    vec3 t0 = (bmin - ro) * invDir;
    vec3 t1 = (bmax - ro) * invDir;
    vec3 tsmall = min(t0, t1);
    vec3 tbig = max(t0, t1);
    float tnear = max(max(tsmall.x, tsmall.y), tsmall.z);
    float tfar = min(min(tbig.x, tbig.y), tbig.z);
    return tfar >= max(tnear, 0.0) && tnear < tMax;
}

bool trace(vec3 ro, vec3 rd, out Hit hit) {
    hit.t = INF;
    vec3 invDir = 1.0 / (rd + vec3(equal(rd, vec3(0.0))) * 1e-8);

    int stack[40];
    int sp = 0;
    stack[sp++] = 0;
    bool found = false;
    vec3 bestNormal = vec3(0, 0, 1);
    int bestTri = -1;

    while (sp > 0) {
        int idx = stack[--sp];
        Node node = nodes[idx];
        if (!slabTest(ro, invDir, node.bmin.xyz, node.bmax.xyz, hit.t)) continue;

        int left = int(node.bmin.w);
        if (left < 0) {                       // leaf
            int first = int(node.extra.x);
            int count = int(node.bmax.w);
            for (int i = 0; i < count; ++i) {
                vec3 n;
                if (intersectTri(ro, rd, tris[first + i], hit.t, n)) {
                    found = true;
                    bestNormal = n;
                    bestTri = first + i;
                }
            }
        } else if (sp < 38) {
            stack[sp++] = left;
            stack[sp++] = int(node.extra.x);
        }
    }

    if (!found) return false;
    hit.n = bestNormal;
    hit.albedo = tris[bestTri].albedo.rgb;
    hit.emissive = tris[bestTri].albedo.w;
    return true;
}

bool occluded(vec3 ro, vec3 rd, float maxT) {
    vec3 invDir = 1.0 / (rd + vec3(equal(rd, vec3(0.0))) * 1e-8);
    int stack[40];
    int sp = 0;
    stack[sp++] = 0;
    while (sp > 0) {
        int idx = stack[--sp];
        Node node = nodes[idx];
        if (!slabTest(ro, invDir, node.bmin.xyz, node.bmax.xyz, maxT)) continue;
        int left = int(node.bmin.w);
        if (left < 0) {
            int first = int(node.extra.x);
            int count = int(node.bmax.w);
            for (int i = 0; i < count; ++i) {
                float t = maxT;
                vec3 n;
                if (intersectTri(ro, rd, tris[first + i], t, n)) return true;
            }
        } else if (sp < 38) {
            stack[sp++] = left;
            stack[sp++] = int(node.extra.x);
        }
    }
    return false;
}

// ------------------------------------------------------------------ sun

vec3 sampleSunDirection() {
    // Uniform sample inside the solar disk, giving genuinely soft shadows.
    float r1 = rand();
    float r2 = rand();
    float cosTheta = 1.0 - r1 * (1.0 - cos(u_sunAngularRadius));
    float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));
    float phi = TAU * r2;
    vec3 t = normalize(abs(u_sunDir.z) < 0.9
                       ? cross(vec3(0, 0, 1), u_sunDir)
                       : cross(vec3(1, 0, 0), u_sunDir));
    vec3 b = cross(u_sunDir, t);
    return normalize(t * (sinTheta * cos(phi)) + b * (sinTheta * sin(phi))
                     + u_sunDir * cosTheta);
}

// ----------------------------------------------------------------- radiance

vec3 radiance(vec3 ro, vec3 rd) {
    vec3 throughput = vec3(1.0);
    vec3 result = vec3(0.0);

    for (int bounce = 0; bounce < u_maxBounces; ++bounce) {
        Hit hit;
        if (!trace(ro, rd, hit)) {
            result += throughput * skyRadiance(rd);
            break;
        }

        vec3 pos = ro + rd * hit.t;
        vec3 n = hit.n;
        if (dot(n, rd) > 0.0) n = -n;      // face the ray

        result += throughput * hit.albedo * hit.emissive * 6.0;

        // Next-event estimation towards the sun.
        if (u_sunDir.z > 0.0) {
            vec3 L = sampleSunDirection();
            float NdotL = dot(n, L);
            if (NdotL > 0.0 && !occluded(pos + n * 2e-3, L, 400.0)) {
                result += throughput * hit.albedo / PI * u_sunColor * NdotL;
            }
        }

        // Diffuse bounce (cosine weighted, so the pdf cancels the cosine).
        throughput *= hit.albedo;
        rd = cosineHemisphere(n);
        ro = pos + n * 2e-3;

        // Russian roulette once the path has dimmed.
        if (bounce >= 2) {
            float p = clamp(max(throughput.r, max(throughput.g, throughput.b)),
                            0.05, 0.95);
            if (rand() > p) break;
            throughput /= p;
        }
    }
    return result;
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= int(u_resolution.x) || pix.y >= int(u_resolution.y)) return;

    rngState = pcgHash(uint(pix.x) + uint(pix.y) * 9781u
                       + uint(u_frame) * 26699u + 1u);

    vec3 sum = vec3(0.0);
    for (int s = 0; s < u_samples; ++s) {
        vec2 jitter = vec2(rand(), rand());
        vec2 uv = (vec2(pix) + jitter) / u_resolution * 2.0 - 1.0;
        vec3 dir = normalize(u_camForward
                             + u_camRight * uv.x * u_tanHalfFov.x
                             + u_camUp * uv.y * u_tanHalfFov.y);
        sum += radiance(u_camPos, dir);
    }

    vec4 prev = imageLoad(u_accum, pix);
    if (u_reset != 0) prev = vec4(0.0);
    imageStore(u_accum, pix, prev + vec4(sum, float(u_samples)));
}
